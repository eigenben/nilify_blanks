source "https://rubygems.org"

gemspec path: ".."

gem "activerecord", "~> 7.0.0"
gem "activesupport", "~> 7.0.0"
gem "rake", ">= 13.0"
gem "rspec", "~> 3.13"
gem "sqlite3", "~> 1.4"

# Rails 6.1 and 7.0 predate these being removed from Ruby's default gems,
# and break with concurrent-ruby 1.3.5+ (which stopped requiring logger).
gem "concurrent-ruby", "< 1.3.5"
gem "base64"
gem "bigdecimal"
gem "drb"
gem "logger"
gem "mutex_m"
